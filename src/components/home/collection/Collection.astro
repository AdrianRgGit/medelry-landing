---
import CollectionItem from "./CollectionItem.astro";

const collectionItems = [
  {
    src: "/media/home/ring-img.webp",
    alt: "Imagen de un anillo.",
    size: "100px",
  },
  {
    src: "/media/home/gloves-img.webp",
    alt: "Imagen de unos guantes.",
    size: "200px",
  },
  {
    src: "/media/home/dress-img.webp",
    alt: "Imagen de un vestido.",
    size: "140px",
  },
  {
    src: "/media/home/earrings-img.webp",
    alt: "Imagen de unos pendientes.",
    size: "120px",
  },
  {
    src: "/media/home/necklace-img.webp",
    alt: "Imagen de un collar.",
    size: "120px",
  },
];
---

<section
  id="collection"
  class="min-h-svh py-24 grid grid-cols-1 gap-10
    md:gap-14
    xl:h-svh xl:py-5 xl:grid-cols-2 xl:gap-0"
>
  <p
    class="w-full max-w-150 mx-auto text-base text-font-red
      md:text-lg
      xl:max-w-none xl:px-30 xl:text-lg xl:col-start-2"
  >
    <span
      class="text-6xl font-piston-black
        md:text-7xl
        xl:text-8xl"
      >E</span
    >ncontrarás joyas, prendas y accesorios de inspiración medieval. Buscamos
    crear, productos que puedan formar parte de tu forma de vestir.
  </p>

  <div
    class="grid grid-cols-2 gap-6 justify-items-center
      md:grid-cols-3 md:gap-8
      lg:grid-cols-5
      xl:flex xl:col-span-2 xl:justify-evenly"
  >
    {
      collectionItems.map((item) => (
        <CollectionItem src={item.src} alt={item.alt} size={item.size} />
      ))
    }
  </div>
</section>
