---
interface Props {
  src: string;
  alt: string;
  size?: string;
}

const { src, alt, size = "100px" } = Astro.props;
---

<div class="relative">
  <img
    src="/media/home/item-frame.webp"
    alt="Marco de decoración para el artículo."
    class="w-40 mx-auto"
  />
  <img
    src={src}
    alt={alt}
    style={{ width: size }}
    class="mx-auto absolute top-1/2 -translate-y-1/2 left-1/2 -translate-x-1/2"
  />
</div>
