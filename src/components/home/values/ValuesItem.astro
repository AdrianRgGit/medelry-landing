---
interface Props {
  title: string;
  src: string;
  alt: string;
}

const { title, src, alt } = Astro.props;

const cleanTitle = title.trim();
const letters = Array.from(cleanTitle);

const firstLetter = letters[0] ?? "";
const restTitle = letters.slice(1).join("");
---

<article
  class="w-full h-44 relative overflow-hidden
    md:h-52
    xl:h-60"
>
  <img
    src={src}
    alt={alt}
    class="w-full h-full absolute inset-0 object-cover"
  />

  <p
    class="px-3 py-1.5 absolute top-2 left-3 z-10 text-sm text-font-red bg-theme-sand/80
      md:px-4 md:py-2 md:top-2.5 md:left-5 md:text-base
      xl:text-base"
  >
    <span
      class="text-4xl font-piston-black
        md:text-5xl
        xl:text-6xl"
      >{firstLetter}</span
    >{restTitle}
  </p>
</article>
