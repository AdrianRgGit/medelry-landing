---
import ValuesItem from "./ValuesItem.astro";
---

<section id="values" class="h-svh ml-64 grid grid-cols-2 items-center gap-12">
  <div class="space-y-12">
    <ValuesItem
      title="Inspiración medieval"
      src="/images/medieval.jpg"
      alt="Imagen de fondo de inspiración medieval"
    />
    <ValuesItem
      title="Cacrácter propio"
      src="/images/medieval.jpg"
      alt="Imagen de fondo de cacrácter propio"
    />
  </div>

  <div class="space-y-12">
    <ValuesItem
      title="Estilo actual"
      src="/images/medieval.jpg"
      alt="Imagen de fondo de estilo actual"
    />
    <ValuesItem
      title="Moda con historia"
      src="/images/medieval.jpg"
      alt="Imagen de fondo de moda con historia"
    />
  </div>
</section>
