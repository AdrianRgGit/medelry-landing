---
import ValuesItem from "./ValuesItem.astro";
---

<section
  id="values"
  class="min-h-svh py-24 grid grid-cols-1 gap-6 items-center
    md:grid-cols-2 md:gap-8
    xl:h-svh xl:py-5 xl:ml-64 xl:gap-12"
>
  <div
    class="space-y-6
      md:space-y-8
      xl:space-y-12"
  >
    <ValuesItem
      title="Inspiración medieval"
      src="/media/home/value-img-1.webp"
      alt="Imagen de fondo de inspiración medieval"
    />
    <ValuesItem
      title="Cacrácter propio"
      src="/media/home/value-img-2.webp"
      alt="Imagen de fondo de cacrácter propio"
    />
  </div>

  <div
    class="space-y-6
      md:space-y-8
      xl:space-y-12"
  >
    <ValuesItem
      title="Estilo actual"
      src="/media/home/value-img-3.webp"
      alt="Imagen de fondo de estilo actual"
    />
    <ValuesItem
      title="Moda con historia"
      src="/media/home/value-img-4.webp"
      alt="Imagen de fondo de moda con historia"
    />
  </div>
</section>
